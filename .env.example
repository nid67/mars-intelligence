# ==============================================================================
# MARS Platform Environment Configuration Template
# SIH26143: Oil Spill Detection & Vessel Attribution
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=true
PROJECT_NAME="MARS — Maritime Intelligence & Forensic Investigation Platform"
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# Primary Execution Data Mode: DEMONSTRATION | REAL_API | HYBRID
DATA_MODE=DEMONSTRATION

# Database Configuration
# PostgreSQL + PostGIS connection string
DATABASE_URL=postgresql+psycopg://mars:mars@localhost:5432/mars
# SQLite fallback is automatically used if PostgreSQL is unreachable or configured:
SQLITE_FALLBACK_DB=data/mars_local.db

# Machine Learning Checkpoint Directory
MODEL_PATH=models/
INFERENCE_DEVICE=cpu

# Cache Directory for Remote Subsets
CACHE_DIR=cache/

# Copernicus Data Space Ecosystem (CDSE) Sentinel-1 Credentials
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Copernicus Marine Service (CMEMS) Credentials & Product IDs
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=
COPERNICUS_MARINE_CURRENT_DATASET=cmems_mod_glo_phy_anfc_0.083deg_P1D-m
COPERNICUS_MARINE_WIND_DATASET=cmems_obs-wind_glo_phy_my_l4_0.125deg_P1D

# Global Fishing Watch (GFW) API Token
GFW_API_TOKEN=

# Default Operational Domain
DEFAULT_REGION=INDIAN_MARITIME_DOMAIN

# Lagrangian Drift Simulation Defaults
DRIFT_DEFAULT_PARTICLES=500
DRIFT_DEFAULT_WINDAGE=0.032
DRIFT_DEFAULT_DIFFUSION=2.5
